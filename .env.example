# Local-only demo credentials. Do not reuse them for a public deployment.
MYSQL_DATABASE=momento_studio
MYSQL_USER=momento
MYSQL_PASSWORD=momento_dev_password
MYSQL_ROOT_PASSWORD=momento_root_dev_password

# Host ports. Container-to-container traffic always uses 3000/8080.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Optional Next.js rewrite target. This value is used while building the
# frontend image, so rebuild after changing it.
# JAVA_API_ORIGIN=http://backend:8080

# Optional auth settings. Keep COOKIE_SECURE=false for local HTTP.
# APP_AUTH_COOKIE_SECURE=false
# APP_SESSION_DAYS=30

# Optional simulation defaults (milliseconds).
# SIM_ASSET_CHECK_DELAY_MS=1800
# SIM_GENERATE_DELAY_MS=4200
# SIM_FINALIZE_DELAY_MS=1500
